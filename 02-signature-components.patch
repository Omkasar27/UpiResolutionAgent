 @import "tailwindcss";
 
+/*
+  ── Theme: "Ledger & Seal" ──────────────────────────────────
+  A UPI dispute is, at its core, a receipt dispute: a paper trail,
+  a reference number, a stamp of resolution. The palette borrows
+  from that world — deep ledger-ink navy, with a brass seal-gold
+  used the way an official stamp would be: sparingly, for the
+  moment something is confirmed or approved.
+
+  These variables override Tailwind's built-in slate / indigo /
+  emerald / amber / red scales, so every existing `bg-slate-900`,
+  `text-indigo-400`, `border-emerald-500` class already in the
+  codebase repaints automatically — no component markup changes.
+*/
+@theme {
+  /* Ink — replaces slate. Structural: backgrounds, borders, body text. */
+  --color-slate-50:  #F5F5FA;
+  --color-slate-100: #E9EAF3;
+  --color-slate-200: #CDD0E4;
+  --color-slate-300: #A6AAC9;
+  --color-slate-400: #7F84AC;
+  --color-slate-500: #5F6590;
+  --color-slate-600: #484D74;
+  --color-slate-700: #363A59;
+  --color-slate-800: #232640;
+  --color-slate-900: #14162A;
+  --color-slate-950: #0A0B16;
+
+  /* Seal Gold — replaces indigo. Brand accent, CTAs, focus, links. */
+  --color-indigo-50:  #FBF3E3;
+  --color-indigo-100: #F6E4C4;
+  --color-indigo-200: #EDCB8E;
+  --color-indigo-300: #E6C480;
+  --color-indigo-400: #E0B563;
+  --color-indigo-500: #C99331;
+  --color-indigo-600: #8F6A1C;
+  --color-indigo-700: #6E5215;
+  --color-indigo-800: #4D3910;
+  --color-indigo-900: #2E220A;
+  --color-indigo-950: #1A1306;
+
+  /* Jade — replaces emerald. Resolved / refund / positive signal. */
+  --color-emerald-50:  #E9FBF3;
+  --color-emerald-100: #CFF6E4;
+  --color-emerald-200: #9FEBC9;
+  --color-emerald-300: #6FDCAE;
+  --color-emerald-400: #4FBE93;
+  --color-emerald-500: #34A57A;
+  --color-emerald-600: #238363;
+  --color-emerald-700: #1B654C;
+  --color-emerald-800: #144A38;
+  --color-emerald-900: #0D3226;
+  --color-emerald-950: #071C15;
+
+  /* Marigold — replaces amber. Pending / in-review signal. */
+  --color-amber-50:  #FDF1E4;
+  --color-amber-100: #FBE1C4;
+  --color-amber-200: #F6C595;
+  --color-amber-300: #F3B67D;
+  --color-amber-400: #F0A868;
+  --color-amber-500: #E08A3F;
+  --color-amber-600: #C06B26;
